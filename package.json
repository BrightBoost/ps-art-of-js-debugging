{
  "name": "skills-app",
  "version": "2.0.0",
  "description": "A small skills app used to practice debugging JavaScript, front to back",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/app.js",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild server/app.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "vite build",
    "start:dist": "node dist/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.4",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0"
  }
}
